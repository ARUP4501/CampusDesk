generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                      String            @id @default(uuid())
  email                   String            @unique
  passwordHash            String
  fullName                String
  role                    String            @default("STUDENT") // STUDENT, WARDEN, STAFF, ADMIN
  employeeId              String?           @unique
  rollNumber              String?           @unique
  phone                   String
  dob                     DateTime?
  gender                  String?           // MALE, FEMALE, OTHER
  bloodGroup              String?           // A+, B+, O+, AB+, A-, B-, O-, AB-
  course                  String?           // B.Tech, M.Tech, MCA, MBA
  department              String?           // CSE, ECE, MECH, CIVIL, EE
  branch                  String?           // CSE, ECE, MECH, CIVIL, EE
  year                    Int?              // 1, 2, 3, 4
  semester                Int?              // 1 - 8
  section                 String?           @default("A") // Section A, B, C
  batch                   String?           // 2022-2026

  // Addresses
  permanentAddress        String?
  currentAddress          String?

  // Parent Details
  fatherName              String?
  fatherPhone             String?
  motherName              String?
  motherPhone             String?

  // Local Guardian Details
  guardianName            String?
  guardianRelation        String?
  guardianPhone           String?
  guardianAddress         String?

  // Hostel Allocation
  hostelBlock             String?
  roomNumber              String?
  bedNumber               String?
  requestedHostel         String?
  roomPreference          String?

  // Living Type & Day Scholar Fields
  livingType              String            @default("HOSTELLER") // HOSTELLER, DAY_SCHOLAR
  busRoute                String?           // For Day Scholars (e.g. Route 1 - Master Canteen)
  pickupPoint             String?           // For Day Scholars (e.g. Khandagiri Square)
  vehicleNumber           String?           // For Day Scholars parking / vehicle pass
  parkingZone             String?           // Assigned / preferred parking zone

  // Verification & Lifecycle
  verificationStatus      String            @default("ACTIVE") // PENDING_WARDEN_VERIFICATION, REJECTED_BY_WARDEN, PENDING_ADMIN_APPROVAL, REJECTED_BY_ADMIN, ACTIVE, INACTIVE
  wardenVerificationDate  DateTime?
  wardenVerificationById  String?
  adminApprovalDate       DateTime?
  adminApprovalById       String?
  rejectionReason         String?

  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Relations
  ticketsCreated          Ticket[]          @relation("StudentTickets")
  ticketsAssigned         Ticket[]          @relation("StaffAssignedTickets")
  auditLogs               TicketAuditLog[]  @relation("AuditUser")
  gatePasses              GatePass[]        @relation("StudentGatePasses")
  gatePassReviews         GatePass[]        @relation("WardenGatePassReviews")
  noticesPublished        Notice[]          @relation("AuthorNotices")
  noticeRecipients        NoticeRecipient[] @relation("RecipientUser")
  docRequests             DocumentRequest[] @relation("StudentDocRequests")
  docReviews              DocumentRequest[] @relation("AdminDocReviews")
  messFeedbacks           MessFeedback[]    @relation("StudentMessFeedback")
  attendance              AttendanceRecord[] @relation("StudentAttendance")
  classCancels            ClassCancellation[] @relation("FacultyClassCancels")
  notifications           InAppNotification[] @relation("UserNotifications")
  pushSubs                PushSubscription[]  @relation("UserPushSubs")
  allocatedBed            Bed?              @relation("StudentBedAllocation")
  transferRequests        HostelTransferRequest[] @relation("StudentTransferRequests")
  documents               StudentDocument[] @relation("StudentDocuments")
  systemAuditLogs         AuditLog[]        @relation("AuditLogActor")
  emergencies             Emergency[]       @relation("StudentEmergencies")
  clubMemberships         ClubMember[]      @relation("StudentClubMemberships")
  eventRegistrations      ClubEventRegistration[] @relation("StudentEventRegistrations")
  parcels                 Parcel[]          @relation("StudentParcels")
  facultyAssignments      FacultyAssignment[]   @relation("FacultyUserAssignments")
  facultyTimetableEntries CourseSchedule[]      @relation("FacultyTimetable")
  facultyAttendanceSessions AttendanceSession[] @relation("FacultyAttendanceSessions")
  studentAttendanceItems  AttendanceRecordItem[] @relation("StudentAttendanceItems")
  facultySubmittedResults StudentResult[]       @relation("FacultySubmittedResults")
  studentResults          StudentResult[]       @relation("StudentResults")

  @@index([role, hostelBlock, verificationStatus, livingType])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserPushSubs", fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Hostel {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "Hostel-A", "Hostel-B", "Hostel-C"
  type        String   @default("BOYS") // BOYS, GIRLS, COED
  wardenId    String?
  description String?
  totalRooms  Int      @default(0)
  totalBeds   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]
}

model Room {
  id          String   @id @default(uuid())
  roomNumber  String   // e.g. "101", "204"
  hostelId    String
  hostel      Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelBlock String   // Denormalized block name e.g. "Hostel-A"
  floor       Int      @default(1)
  capacity    Int      @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beds        Bed[]

  @@unique([hostelBlock, roomNumber])
  @@index([hostelBlock])
}

model Bed {
  id          String   @id @default(uuid())
  bedNumber   String   // "Bed-1", "Bed-2", "A", "B"
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomNumber  String
  hostelBlock String
  status      String   @default("AVAILABLE") // "AVAILABLE", "OCCUPIED", "MAINTENANCE"
  studentId   String?  @unique
  student     User?    @relation("StudentBedAllocation", fields: [studentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hostelBlock, roomNumber, bedNumber])
  @@index([hostelBlock, status])
}

model HostelTransferRequest {
  id            String   @id @default(uuid())
  requestNumber String   @unique
  studentId     String
  student       User     @relation("StudentTransferRequests", fields: [studentId], references: [id], onDelete: Cascade)
  fromHostel    String
  fromRoom      String?
  fromBed       String?
  toHostel      String
  toRoom        String?
  reason        String
  status        String   @default("PENDING_WARDEN") // PENDING_WARDEN, REJECTED_BY_WARDEN, PENDING_ADMIN, APPROVED, REJECTED_BY_ADMIN
  wardenRemark  String?
  adminRemark   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId, status])
  @@index([toHostel, status])
}

model StudentDocument {
  id              String    @id @default(uuid())
  studentId       String
  student         User      @relation("StudentDocuments", fields: [studentId], references: [id], onDelete: Cascade)
  docType         String    // ID_PROOF, ADMISSION_PROOF, ADDRESS_PROOF, GUARDIAN_ID, OTHER
  docName         String
  fileUrl         String?
  status          String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason String?
  uploadedAt      DateTime  @default(now())
  verifiedAt      DateTime?

  @@index([studentId, status])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actorId     String
  actor       User     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorRole   String
  targetType  String   // STUDENT, WARDEN, STAFF, HOSTEL, ROOM, BED, NOTICE, MESS
  targetId    String?
  details     String
  hostelBlock String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
  @@index([hostelBlock])
}

model Ticket {
  id                  String          @id @default(uuid())
  ticketNumber        String          @unique
  studentId           String
  student             User            @relation("StudentTickets", fields: [studentId], references: [id])
  title               String
  description         String
  category            String
  predictedCategory   String?
  isCategoryCorrected Boolean         @default(false)
  hostelBlock         String
  roomNumber          String
  priority            String          @default("MEDIUM")
  status              String          @default("SUBMITTED")
  assignedStaffId     String?
  assignedStaff       User?           @relation("StaffAssignedTickets", fields: [assignedStaffId], references: [id])
  photoData           Bytes?
  photoMimeType       String?
  escalationLevel     Int             @default(0)
  escalatedAt         DateTime?
  slaDeadline         DateTime?
  isOverdue           Boolean         @default(false)
  manualPriorityOverride Boolean        @default(false)
  priorityOverriddenById String?
  priorityOverrideReason String?
  resolvedAt          DateTime?
  resolutionNote      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  auditLogs           TicketAuditLog[]

  @@index([category, hostelBlock, roomNumber])
  @@index([status, priority, createdAt])
}

model TicketAuditLog {
  id          String    @id @default(uuid())
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User      @relation("AuditUser", fields: [changedById], references: [id])
  fromStatus  String?
  toStatus    String
  action      String
  note        String
  createdAt   DateTime  @default(now())

  @@index([ticketId, createdAt])
}

model GatePass {
  id                 String         @id @default(uuid())
  passNumber         String         @unique
  studentId          String
  student            User           @relation("StudentGatePasses", fields: [studentId], references: [id])
  type               String
  departureDate      DateTime
  expectedReturnDate DateTime
  actualExitTime     DateTime?
  actualEntryTime    DateTime?
  destination        String
  reason             String
  parentContact      String
  status             String         @default("PENDING")
  approvedById       String?
  approvedBy         User?          @relation("WardenGatePassReviews", fields: [approvedById], references: [id])
  wardenComment      String?
  qrCodeData         String?
  securityGuardName  String?
  securityNotes      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([studentId, status])
}

model Notice {
  id             String           @id @default(uuid())
  title          String
  content        String
  category       String           @default("GENERAL")
  priority       String           @default("NORMAL")
  targetType     String           @default("ALL")
  targetValue    String?
  publishedById  String
  publishedBy    User             @relation("AuthorNotices", fields: [publishedById], references: [id])
  requiresAction Boolean          @default(false)
  actionType     String           @default("NONE")
  actionDeadline DateTime?
  actionLink     String?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  recipients     NoticeRecipient[]

  @@index([targetType, targetValue])
  @@index([category])
}

model NoticeRecipient {
  id                 String    @id @default(uuid())
  noticeId           String
  notice             Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  studentId          String
  student            User      @relation("RecipientUser", fields: [studentId], references: [id], onDelete: Cascade)
  isDelivered        Boolean   @default(true)
  deliveredAt        DateTime  @default(now())
  isRead             Boolean   @default(false)
  readAt             DateTime?
  isActionDone       Boolean   @default(false)
  actionCompletedAt  DateTime?
  actionNotes        String?
  reminderSentCount  Int       @default(0)
  lastReminderSentAt DateTime?

  @@unique([noticeId, studentId])
  @@index([studentId, isRead])
}

model CourseSchedule {
  id                 String              @id @default(uuid())
  course             String              @default("B.Tech")
  branch             String
  year               Int
  semester           Int                 @default(1)
  section            String              @default("A")
  batch              String?
  subjectCode        String
  subjectName        String
  facultyName        String
  facultyId          String?
  faculty            User?               @relation("FacultyTimetable", fields: [facultyId], references: [id])
  subjectId          String?
  subject            Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dayOfWeek          Int
  startTime          String
  endTime            String
  room               String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime?           @updatedAt

  attendanceSessions AttendanceSession[]

  @@index([branch, year, dayOfWeek])
  @@index([course, branch, semester, section])
  @@index([facultyId, dayOfWeek])
}

model ClassCancellation {
  id          String   @id @default(uuid())
  subjectName String
  facultyName String
  date        DateTime
  branch      String
  year        Int
  reason      String
  postedById  String
  postedBy    User     @relation("FacultyClassCancels", fields: [postedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branch, year, date])
}

model AttendanceRecord {
  id              String   @id @default(uuid())
  studentId       String
  student         User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  subjectCode     String
  subjectName     String
  totalClasses    Int
  attendedClasses Int
  semester        Int
  updatedAt       DateTime @default(now())

  @@unique([studentId, subjectCode, semester])
}

model MessMenu {
  id          String   @id @default(uuid())
  hostelBlock String
  dayOfWeek   Int
  breakfast   String
  lunch       String
  snacks      String
  dinner      String
  updatedAt   DateTime @default(now())

  @@unique([hostelBlock, dayOfWeek])
}

model MessFeedback {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation("StudentMessFeedback", fields: [studentId], references: [id])
  hostelBlock String
  mealType    String
  date        DateTime @default(now())
  rating      Int
  comments    String?
  createdAt   DateTime @default(now())

  @@index([hostelBlock, mealType, date])
}

model DocumentRequest {
  id             String         @id @default(uuid())
  requestNumber  String         @unique
  studentId      String
  student        User           @relation("StudentDocRequests", fields: [studentId], references: [id])
  docType        String
  purpose        String
  status         String         @default("SUBMITTED")
  approvedById   String?
  approvedBy     User?          @relation("AdminDocReviews", fields: [approvedById], references: [id])
  remarks        String?
  generatedPdfUrl String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([studentId, status])
}

model FeeRecord {
  id           String    @id @default(uuid())
  rollNumber   String
  studentName  String
  totalFee     Float
  paidFee      Float
  dueFee       Float
  dueDate      DateTime
  semester     Int
  academicYear String
  status       String    @default("DUE")
  importedAt   DateTime  @default(now())

  @@unique([rollNumber, semester, academicYear])
  @@index([rollNumber])
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ClassifierTrainingData {
  id        String   @id @default(uuid())
  text      String
  category  String
  source    String   @default("INITIAL")
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// SOS & CAMPUS EMERGENCY RESPONSE
// ----------------------------------------------------
model Emergency {
  id               String    @id @default(uuid())
  alertNumber      String    @unique // e.g. "SOS-8001"
  studentId        String
  student          User      @relation("StudentEmergencies", fields: [studentId], references: [id], onDelete: Cascade)
  studentType      String?   // HOSTELLER, DAY_SCHOLAR
  category         String    // MEDICAL, FIRE_SMOKE, LIFT_STUCK, SECURITY, ELECTRICAL, OTHER
  location         String    // Context-aware auto string (Hostel/Floor/Room or Academic Block/Campus Area)
  emergencyContact String?   // Guardian / parent contact at time of alert
  coordinates      String?   // Optional GPS coords e.g. "20.3541,85.8192"
  description      String?
  status           String    @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED (NEW supported as alias for ACTIVE)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  responderNotes   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([studentId])
}

// ----------------------------------------------------
// CAMPUS CLUBS & STUDENT ENGAGEMENT
// ----------------------------------------------------
model Club {
  id               String             @id @default(uuid())
  name             String             @unique // e.g. "Coding & Technology Club", "Yoga & Wellness Society"
  category         String             // CODING_TECH, YOGA_WELLNESS, MUSIC, DANCE, ART_CREATIVITY, PHOTOGRAPHY, DRAMA_THEATRE, SPORTS_FITNESS, LITERATURE_DEBATE, PUBLIC_SPEAKING, SOCIAL_SERVICE, MEDIA_CONTENT
  description      String
  logoIcon         String?            @default("Sparkles") // Lucide icon name or emoji
  coordinatorName  String?
  coordinatorEmail String?
  coordinatorPhone String?
  meetingSchedule  String?            // e.g. "Wednesdays & Saturdays @ 5:30 PM, Student Activity Center"
  roomLocation     String?            // e.g. "SAC Room 102"
  isRecruiting     Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  members          ClubMember[]
  events           ClubEvent[]
  announcements    ClubAnnouncement[]
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentClubMemberships", fields: [studentId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEAD, COORDINATOR, MEMBER
  joinedAt  DateTime @default(now())

  @@unique([clubId, studentId])
  @@index([studentId])
}

model ClubEvent {
  id            String                  @id @default(uuid())
  clubId        String
  club          Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title         String
  description   String
  date          DateTime
  location      String
  capacity      Int                     @default(100)
  isCancelled   Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  registrations ClubEventRegistration[]

  @@index([clubId, date])
}

model ClubEventRegistration {
  id           String    @id @default(uuid())
  eventId      String
  event        ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation("StudentEventRegistrations", fields: [studentId], references: [id], onDelete: Cascade)
  registeredAt DateTime  @default(now())

  @@unique([eventId, studentId])
  @@index([studentId])
}

model ClubAnnouncement {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

// ----------------------------------------------------
// PLANNED CAMPUS MAINTENANCE
// ----------------------------------------------------
model PlannedMaintenance {
  id             String   @id @default(uuid())
  title          String   // e.g. "Hostel-B Water Pipeline Maintenance"
  description    String   // e.g. "Overhead tank cleaning and valve repair. Water supply suspended 2 PM - 5 PM."
  location       String   // e.g. "Hostel-B", "Campus Wi-Fi Core", "Academic Block 2"
  category       String   // WATER, ELECTRICAL, NETWORK, ELEVATOR, GENERAL
  startTime      DateTime
  endTime        DateTime
  targetAudience String   @default("ALL") // ALL, HOSTELLER, DAY_SCHOLAR, HOSTEL_A, HOSTEL_B, HOSTEL_C
  status         String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, startTime])
}

// ----------------------------------------------------
// PARCEL MANAGEMENT
// ----------------------------------------------------
model Parcel {
  id               String    @id @default(uuid())
  parcelNumber     String    @unique // e.g. "PCL-7001"
  studentId        String
  student          User      @relation("StudentParcels", fields: [studentId], references: [id], onDelete: Cascade)
  trackingNumber   String?
  courierService   String    // Amazon, Flipkart, BlueDart, Delhivery, SpeedPost, Other
  securityLocation String    @default("Main Gate Security Desk")
  otpCode          String    // 4-digit verification code e.g. "6291"
  status           String    @default("RECEIVED") // RECEIVED, COLLECTED, RETURNED_TO_COURIER
  receivedAt       DateTime  @default(now())
  collectedAt      DateTime?
  verifiedByGuard  String?
  notes            String?

  @@index([studentId, status])
}

// ----------------------------------------------------
// CAMPUS TRANSPORT MANAGEMENT (BUSES, ROUTES & STOPS)
// ----------------------------------------------------
model Bus {
  id            String     @id @default(uuid())
  busNumber     String     @unique // e.g. "BUS-01", "BUS-02"
  vehicleNumber String     // e.g. "OD-02-AX-4450"
  capacity      Int        @default(50)
  driverName    String     // e.g. "Bishnu Charan Das"
  driverPhone   String     // e.g. "9876543401"
  status        String     @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  routes        BusRoute[]

  @@index([status])
}

model BusRoute {
  id          String      @id @default(uuid())
  routeNumber String      @unique // e.g. "Route 1"
  routeName   String      // e.g. "Master Canteen to Campus"
  description String?     // e.g. "Daily scholar route covering Master Canteen, Vani Vihar, Rasulgarh and Patia."
  startPoint  String      // e.g. "Master Canteen"
  destination String      // e.g. "Campus Main Gate"
  status      String      @default("ACTIVE") // ACTIVE, INACTIVE
  delayStatus String      @default("ON_TIME") // ON_TIME, DELAYED, CANCELLED
  delayNotice String?
  busId       String?
  bus         Bus?        @relation(fields: [busId], references: [id], onDelete: SetNull)
  stops       RouteStop[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([busId])
}

model RouteStop {
  id         String   @id @default(uuid())
  routeId    String
  route      BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName   String   // e.g. "Vani Vihar Square"
  location   String?  // e.g. "Near Overbridge / NH-16"
  pickupTime String   // e.g. "07:45 AM"
  dropTime   String?  // e.g. "05:30 PM"
  stopOrder  Int      // 1, 2, 3...
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([routeId, stopOrder])
}

// ----------------------------------------------------
// DAY SCHOLAR TRANSPORT & PARKING
// ----------------------------------------------------
model TransportRoute {
  id                String   @id @default(uuid())
  routeNumber       String   @unique // e.g. "Route 1"
  routeName         String   // e.g. "Master Canteen - Vani Vihar - Patia - Campus"
  busNumber         String   // e.g. "OD-02-AX-4450"
  driverName        String
  driverPhone       String
  stops             String   // JSON array string: [{"name":"Master Canteen","time":"07:30 AM"},{"name":"Vani Vihar","time":"07:45 AM"}]
  morningDeparture  String   // "07:30 AM"
  eveningDeparture  String   // "05:15 PM"
  status            String   @default("ON_TIME") // ON_TIME, DELAYED, MAINTENANCE
  statusNote        String?
  updatedAt         DateTime @default(now()) @updatedAt
}

model ParkingZone {
  id             String   @id @default(uuid())
  name           String   @unique // e.g. "Zone A - 2-Wheeler (Near Gate 1)"
  vehicleType    String   // TWO_WHEELER, FOUR_WHEELER
  totalSlots     Int
  occupiedSlots  Int      @default(0)
  status         String   @default("AVAILABLE") // AVAILABLE, FULL, RESTRICTED
  notice         String?
  updatedAt      DateTime @default(now()) @updatedAt
}

// ----------------------------------------------------
// EXPANDED ACADEMIC COURSES & BRANCHES MASTER DATA
// ----------------------------------------------------
model AcademicCourse {
  id            String           @id @default(uuid())
  code          String           @unique // e.g. "MCA", "BCA", "BBA", "B.Tech", "MBA", "M.Tech"
  name          String           // e.g. "Master of Computer Applications"
  durationYears Int              @default(2) // 2, 3, 4
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  branches      AcademicBranch[]

  @@index([isActive])
}

model AcademicBranch {
  id          String         @id @default(uuid())
  courseId    String
  course      AcademicCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code        String         // e.g. "CA", "DS", "CSE", "IT", "HRM"
  name        String         // e.g. "Computer Applications", "Data Science", "Computer Science & Engineering"
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([courseId, code])
  @@index([courseId, isActive])
}

// ----------------------------------------------------
// ACADEMIC SUBJECTS, FACULTY ASSIGNMENTS, ATTENDANCE & RESULTS
// ----------------------------------------------------
model Subject {
  id          String   @id @default(uuid())
  code        String   // e.g. "CS301", "MCA101"
  name        String   // e.g. "Database Management Systems"
  course      String   // e.g. "MCA", "B.Tech"
  branch      String   // e.g. "CA", "CSE"
  year        Int      @default(1)
  semester    Int      @default(1)
  type        String   @default("THEORY") // THEORY, PRACTICAL, LAB
  credits     Int      @default(3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facultyAssignments FacultyAssignment[]
  timetableEntries   CourseSchedule[]
  attendanceSessions AttendanceSession[]
  results            StudentResult[]

  @@unique([course, branch, semester, code])
  @@index([course, branch, semester, isActive])
}

model FacultyAssignment {
  id           String   @id @default(uuid())
  facultyId    String
  faculty      User     @relation("FacultyUserAssignments", fields: [facultyId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course       String
  branch       String
  year         Int      @default(1)
  semester     Int      @default(1)
  section      String   @default("A")
  academicYear String?  @default("2024-2025")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([facultyId, subjectId, section, semester])
  @@index([facultyId, isActive])
  @@index([course, branch, semester, section])
}

model AttendanceSession {
  id               String                 @id @default(uuid())
  date             DateTime               // lecture date
  timetableEntryId String?
  timetableEntry   CourseSchedule?        @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  facultyId        String
  faculty          User                   @relation("FacultyAttendanceSessions", fields: [facultyId], references: [id])
  subjectId        String
  subject          Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course           String
  branch           String
  year             Int
  semester         Int
  section          String                 @default("A")
  topic            String?
  startTime        String?
  endTime          String?
  createdAt        DateTime               @default(now())

  records          AttendanceRecordItem[]

  @@index([facultyId, date])
  @@index([course, branch, semester, section, date])
}

model AttendanceRecordItem {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("StudentAttendanceItems", fields: [studentId], references: [id], onDelete: Cascade)
  status    String            @default("PRESENT") // PRESENT, ABSENT, LATE
  remarks   String?
  createdAt DateTime          @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model StudentResult {
  id              String    @id @default(uuid())
  studentId       String
  student         User      @relation("StudentResults", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId       String
  faculty         User      @relation("FacultySubmittedResults", fields: [facultyId], references: [id])
  course          String
  branch          String
  year            Int
  semester        Int
  section         String    @default("A")
  internalMarks   Float?    // e.g. 26
  assignmentMarks Float?    // e.g. 18
  practicalMarks  Float?    // e.g. 24
  endSemMarks     Float?    // e.g. 68
  totalMarks      Float?    // e.g. 86
  maxMarks        Float?    @default(100)
  grade           String?   // e.g. "O", "E", "A", "B", "C", "D", "F"
  credits         Int       @default(3)
  status          String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([studentId, subjectId, semester])
  @@index([studentId, status])
  @@index([subjectId, section, semester])
}

