# CampusDesk Environment Configuration

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://campusdesk:campusdesk_secret@localhost:5432/campusdesk_db?schema=public

# Session Secret (minimum 32 characters)
JWT_SECRET=campusdesk_super_secret_session_token_key_development_32chars

# Web Push Notification VAPID Keys (Free, generated via npm run generate-vapid in server)
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSPOSnfMSC2101MmVC30RE4FTC4m5006_5PU
VAPID_PRIVATE_KEY=1wR7_2L-rW56G2oQ_17uX_14l_11O_00l-57G_99l-4
VAPID_SUBJECT=mailto:admin@campusdesk.edu

# Optional Email SMTP (Disabled by default, no paid provider required)
ENABLE_EMAIL=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Demo Data Banner in Admin Dashboard
SHOW_SAMPLE_BANNER=true
